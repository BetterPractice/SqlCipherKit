--swift-version 6.2
--language-mode 6
--exclude .build, Sources/CSqlCipher

# Indentation
--indent 4
--tab-width 4
--smart-tabs enabled
--indent-case false
--ifdef no-indent
--indent-strings true

# Line endings / whitespace
--trim-whitespace always
--linebreaks lf
--max-width none

# Braces
--empty-braces no-space
--allman false

# Imports
--import-grouping testable-last

# Closures / redundant syntax
--strip-unused-args closure-only
--semicolons never
--property-types inferred

# self
--self remove

# Disabled rules — avoid conflicts with test code and Sendable conformances
--disable noForceUnwrapInTests,noForceTryInTests,redundantSendable

# Disabled rules — house style.  Rules SwiftFormat enables by default that the
# codebase does not follow.  Enable one by deleting it here and running
# `swiftformat .` in the same change.
#   Blank lines: a blank line opens types; MARK and import spacing is free-form.
--disable blankLinesAtStartOfScope,blankLinesBetweenScopes,blankLinesAroundMark,blankLinesBetweenImports
#   Wrapping: short bodies stay on one line; arguments wrap where they read best.
--disable wrapFunctionBodies,wrapPropertyBodies,wrapIfStatementBodies,wrapIfExpressionBodies,wrapLoopBodies,wrapArguments,wrapMultilineStatementBraces
#   Swift Testing: tests keep @Test("description") names, not raw identifiers.
--disable swiftTestingTestCaseNames
#   Expressions and declarations written as the author chose.
--disable redundantReturn,redundantSelf,hoistPatternLet,hoistTry,hoistAwait,conditionalAssignment,opaqueGenericParameters,repeatedGuard,extensionAccessControl
#   Spacing: aligned comments and operators are allowed; trailing commas optional.
--disable consecutiveSpaces,spaceAroundOperators,trailingCommas
